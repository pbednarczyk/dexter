meta {
  name: Własna wiadomość
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/chat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "message": "Cześć! W czym możesz mi pomóc?"
  }
}

tests {
  test("Kontrakt odpowiedzi ChatResult", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.trace_id).to.equal(res.getHeader("x-trace-id"));
    expect(body.response).to.be.a("string").and.not.empty;
    expect(body.actions).to.be.an("array");
    expect(body.actions.length).to.be.at.most(5);
    body.actions.forEach(function (action) {
      expect(action.tool).to.be.a("string");
      expect(action).to.have.property("arguments");
      expect(action).to.have.property("result");
      expect(action).to.have.property("error");
      if (action.error !== null) expect(action.error).to.be.a("string");
    });
  });
}

docs {
  Edytuj message w zakładce Body. Sprawdza kontrakt odpowiedzi; HTTP 200 może także zawierać komunikat o niedostępności modelu.
}
