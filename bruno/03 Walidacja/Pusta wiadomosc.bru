meta {
  name: Pusta wiadomosc
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/chat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "message": "   "
  }
}

tests {
  test("Niepoprawny request zwraca 422", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().detail).to.be.an("array").and.not.empty;
    res.getBody().detail.forEach(function (error) {
      expect(error.loc).to.be.an("array");
      expect(error.msg).to.be.a("string");
      expect(error.type).to.be.a("string");
    });
  });
}

