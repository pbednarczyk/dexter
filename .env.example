APP_ENV=dev
DEXTER_PORT=8000
LLM_PROVIDER=ollama
LLM_OPTIONS={}
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:14b
AGENT_MAX_STEPS=5
OLLAMA_TIMEOUT_SECONDS=120

# RabbitMQ is selected only with LLM_PROVIDER=rabbitmq.
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/wordtracker
RABBITMQ_USER=wordtracker
RABBITMQ_PASSWORD=
RABBITMQ_LLM_JOBS_QUEUE=llm.jobs
RABBITMQ_LLM_TIMEOUT=300
# Keep false until dexter-worker routes results to AMQP reply_to.
RABBITMQ_REPLY_TO_ENABLED=false
